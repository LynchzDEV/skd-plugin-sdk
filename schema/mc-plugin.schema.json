{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LynchzDEV/mc-plugin-sdk/schema/mc-plugin.schema.json",
  "title": "Mission Control plugin manifest",
  "description": "mc-plugin.json at the root of a Mission Control plugin repo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "pluginApi",
    "runtime",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,38}[a-z0-9])$",
      "description": "3-40 characters of lowercase letters, digits and dashes."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "pluginApi": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "The Mission Control plugin API this plugin targets. 2 is needed for contributes. Any other version is refused with: This plugin needs a newer Mission Control."
    },
    "runtime": {
      "enum": [
        "trusted",
        "isolated"
      ]
    },
    "icon": {
      "$ref": "#/$defs/repoPath"
    },
    "server": {
      "$ref": "#/$defs/repoPath"
    },
    "screen": {
      "$ref": "#/$defs/repoPath"
    },
    "queueSource": {
      "type": "boolean",
      "description": "Shows this plugin's Mission Control queue under it in the sidebar."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\*\\.)?(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
            "description": "A plain host name such as api.clickup.com, or *. and a host of at least two labels such as *.clickup-attachments.com. No other wildcards, no URLs."
          }
        },
        "sessions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "chat",
              "terminal"
            ]
          }
        },
        "settings": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settingField"
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Agents and skills Mission Control copies into each engine's config, and Studio flows it lists, while the plugin is installed and enabled; uninstalling removes them. Needs pluginApi 2 and the user's trust.",
      "properties": {
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$",
            "description": "An agent .md file inside the plugin repo, with name: in its frontmatter."
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\.md$)(?!.*/$).+$",
            "description": "A skill folder inside the plugin repo, holding SKILL.md with name: in its frontmatter."
          }
        },
        "flows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$",
            "description": "A Studio flow .json file inside the plugin repo. Mission Control checks it with Studio's own flow rules at install."
          }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "description": "A path inside the plugin repo: relative, no leading slash, no parent segments."
    },
    "settingField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "secret"
          ]
        },
        "help": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "contributes"
        ]
      },
      "then": {
        "properties": {
          "pluginApi": {
            "const": 2
          }
        }
      }
    }
  ]
}
